[nemesis]
version=1.1
id=battery.watchdog
name=مراقب البطارية
type=application,service
package-version=0.0.0
short-desc=مراقبة بطارية 12V والتنبيه قبل نفاد الشحن
detailed-desc=يسجل مستوى شحن بطارية 12V أثناء عمل السيارة، ويعرض استهلاك التوقف، وينبهك عند انخفاض شحن البطارية. للقراءة فقط دون إرسال أي بيانات للسيارة.
os=any
models=any
repository=https://github.com/abdullahO2/gen5w-BatteryWatchdog
preinstall=scripts/preinstall.sh
postinstall=scripts/post.sh

[app.0]
kind=apk
path=app/batterywatchdog.apk
package=com.nemesis.batterywatchdog
component=com.nemesis.batterywatchdog/.MainActivity

[service.0]
name=watch
kind=sh
path=svc/watchdog.sh
uid=root
mode=restart
